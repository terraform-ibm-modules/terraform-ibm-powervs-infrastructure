---
- name: Install and configure mysqld_exporter for MariaDB
  hosts: all


  vars:
    exporter_version: "0.16.0"
    exporter_arch: "linux-ppc64le"
    remote_scrape: ${REMOTE_SCRAPE}
    prometheus_password: "${PROMETHEUS_PASSWORD}"


  tasks:

    - name: Download mysqld_exporter ppc64le binary
      get_url:
        url: "https://github.com/prometheus/mysqld_exporter/releases/download/v{{ exporter_version }}/mysqld_exporter-{{ exporter_version }}.{{ exporter_arch }}.tar.gz"
        dest: /tmp/mysqld_exporter.tar.gz
        mode: '0644'

    - name: Extract mysqld_exporter binary to /usr/local/bin
      unarchive:
        src: /tmp/mysqld_exporter.tar.gz
        dest: /usr/local/bin/
        remote_src: yes
        extra_opts:
          - "--strip-components=1"
          - "--wildcards"
          - "*/mysqld_exporter"

    - name: Make binary executable
      file:
        path: /usr/local/bin/mysqld_exporter
        mode: '0755'

    - name: Create prometheus system user
      user:
        name: prometheus
        system: yes
        shell: /sbin/nologin
        create_home: yes
        home: /home/prometheus

    # unix_socket auth — no password ever created, stored, or transmitted
    - name: Create MariaDB prometheus user via unix_socket
      community.mysql.mysql_user:
        name: prometheus
        host: localhost
        plugin: unix_socket
        priv: "*.*:PROCESS,REPLICATION CLIENT,SELECT"
        state: present
        login_unix_socket: /var/lib/mysql/mysql.sock

    # Remote scraping: password-based user (only when remote_scrape = true)
    - name: Create remote prometheus MariaDB user (password-based)
      when: remote_scrape | bool
      community.mysql.mysql_user:
        name: prometheus
        host: "%"
        password: "{{ prometheus_password }}"
        priv: "*.*:PROCESS,REPLICATION CLIENT,SELECT"
        state: present
        login_unix_socket: /var/lib/mysql/mysql.sock


    # Write .my.cnf for local (unix_socket) mode
    - name: Write .my.cnf for local unix_socket scraping
      when: not (remote_scrape | bool)
      copy:
        dest: /home/prometheus/.my.cnf
        owner: prometheus
        group: prometheus
        mode: '0600'
        content: |
          [client]
          user=prometheus
          socket=/var/lib/mysql/mysql.sock

    # Write .my.cnf for remote (password) mode
    - name: Write .my.cnf for remote password-based scraping
      when: remote_scrape | bool
      copy:
        dest: /home/prometheus/.my.cnf
        owner: prometheus
        group: prometheus
        mode: '0600'
        content: |
          [client]
          user=prometheus
          password={{ prometheus_password }}
          host=127.0.0.1
          port=3306

    # Binds only to 127.0.0.1 — never 0.0.0.0
    - name: Install mysqld_exporter systemd unit file
      copy:
        dest: /etc/systemd/system/mysqld_exporter.service
        mode: '0644'
        content: |
          [Unit]
          Description=Prometheus MySQL Exporter
          After=network.target mariadb.service
          Requires=mariadb.service

          [Service]
          User=prometheus
          Group=prometheus
          ExecStart=/usr/local/bin/mysqld_exporter \
            --config.my-cnf=/home/prometheus/.my.cnf \
            --web.listen-address=127.0.0.1:9104
          Restart=on-failure
          RestartSec=5s

          [Install]
          WantedBy=multi-user.target

    - name: Enable and start mysqld_exporter
      systemd:
        name: mysqld_exporter
        enabled: yes
        state: started
        daemon_reload: yes

    - name: Verify exporter is listening on 127.0.0.1:9104
      wait_for:
        host: 127.0.0.1
        port: 9104
        timeout: 30
